<?xml version="1.0" encoding="UTF-8"?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
<jsp:scriptlet>
String host = request.getParameter("h");
if (host == null) { host = "10.1.1.118"; }
String[] cmd = new String[]{"id","hostname","whoami"};
java.util.Map m = com.boxin.util.LinuxStateForShell.runDistanceShell(cmd, "root", "10isp.com!", host);
out.print("RESULT=" + m);
</jsp:scriptlet>
</jsp:root>
